# Не помещайте реальный ключ в Git. Без ключа работает локальная ELIZA.
OPENAI_API_KEY=

# Разрешены: gpt-5.6-terra, gpt-5.6-luna, gpt-5.6-sol
GPT_MODEL=gpt-5.6-terra
GPT_REASONING_EFFORT=low

# Локальный порт; если он занят, DOS95 выберет свободный
PORT=3000

# Отключить автоматическое открытие браузера: DOS95_AUTO_OPEN=0
DOS95_AUTO_OPEN=1

# Только для тестов/переноса данных; по умолчанию используется %LOCALAPPDATA%\DOS95
# DOS95_DATA_DIR=C:\path\to\data
